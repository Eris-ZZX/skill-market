{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Skill Market",
  "version": "0.1.0",
  "identifier": "com.company.skillmarket",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3100",
    "beforeDevCommand": "pnpm run dev:renderer",
    "beforeBuildCommand": "pnpm run build:renderer"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Skill Market",
        "width": 760,
        "height": 480,
        "minWidth": 640,
        "minHeight": 420,
        "resizable": true,
        "center": true,
        "decorations": true,
        "transparent": false,
        "visible": true,
        "focus": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https: http:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https: http:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      }
    }
  }
}
